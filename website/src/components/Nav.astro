---
const navLinks = [
  { label: "Features", href: "/#features" },
  { label: "Showcase", href: "/#showcase" },
  { label: "Predictions", href: "/#predictions" },
  { label: "Pricing", href: "/#pricing" },
  { label: "About", href: "/about/" },
  { label: "Blog", href: "/blog/" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    id="nav-pill"
    class="glass hairline mx-auto flex max-w-5xl items-center justify-between rounded-full py-2 pl-5 pr-2 shadow-[0_10px_40px_-24px_rgba(13,27,22,0.5)] transition-[max-width,box-shadow] duration-500 ease-brand"
  >
    <a href="/" class="group flex items-center gap-2.5" aria-label="Mero Udhyog home">
      <img
        src="/logo-mark.svg"
        alt=""
        width="32"
        height="32"
        class="size-8 transition-transform duration-500 ease-brand group-hover:-rotate-6"
      />
      <span class="text-[15px] font-semibold tracking-tight text-forest-950">Mero Udhyog</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-2 text-sm font-medium text-forest-950/70 transition-colors duration-200 hover:bg-forest-950/5 hover:text-forest-950"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href="https://mero-udhyog.vercel.app/login"
        class="rounded-full px-4 py-2 text-sm font-medium text-forest-950/75 transition-colors duration-200 hover:text-forest-950"
        >Log in</a
      >
      <a
        href="https://mero-udhyog.vercel.app/register"
        data-motion="scale"
        class="btn-primary rounded-full px-4.5 py-2 text-sm font-medium">Get started</a
      >
    </div>

    <button
      id="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      class="grid size-10 place-items-center rounded-full text-forest-950 transition-colors hover:bg-forest-950/5 lg:hidden"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path class="menu-line-1" d="M3 6h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        <path class="menu-line-2" d="M3 12h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="glass hairline mx-auto mt-2 max-w-5xl origin-top scale-y-0 rounded-3xl p-5 opacity-0 shadow-xl transition-all duration-400 ease-brand lg:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-4 py-3 text-[15px] font-medium text-forest-950/80 transition-colors hover:bg-forest-950/5"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="mt-3 flex flex-col gap-2 border-t border-forest-950/10 pt-4">
      <a
        href="https://mero-udhyog.vercel.app/login"
        class="btn-ghost rounded-full px-4 py-2.5 text-center text-sm font-medium">Log in</a
      >
      <a
        href="https://mero-udhyog.vercel.app/register"
        class="btn-primary rounded-full px-4 py-2.5 text-center text-sm font-medium">Get started — free</a
      >
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const pill = document.getElementById("nav-pill");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  let open = false;

  const setOpen = (next: boolean) => {
    open = next;
    if (!menu || !toggle) return;
    menu.style.opacity = open ? "1" : "0";
    menu.style.transform = open ? "scaleY(1)" : "scaleY(0)";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    const l1 = toggle.querySelector(".menu-line-1") as SVGPathElement | null;
    const l2 = toggle.querySelector(".menu-line-2") as SVGPathElement | null;
    if (l1 && l2) {
      l1.style.transform = open ? "translateY(3px) rotate(45deg)" : "";
      l2.style.transform = open ? "translateY(-3px) rotate(-45deg)" : "";
      l1.style.transformOrigin = "center";
      l2.style.transformOrigin = "center";
      l1.style.transition = l2.style.transition = "transform 0.3s cubic-bezier(0.22,1,0.36,1)";
    }
  };

  toggle?.addEventListener("click", () => setOpen(!open));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 24;
        pill?.classList.toggle("max-w-3xl", scrolled);
        pill?.classList.toggle("shadow-lg", scrolled);
        header?.classList.toggle("pointer-events-none", false);
        ticking = false;
      });
    },
    { passive: true },
  );
</script>
